GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_ORG=MUICT-Class
GITHUB_REPO=owner/repository-name
GITHUB_BRANCH=main
JWT_SECRET=your_secret_key_change_this_in_production_min_32_chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# PostgreSQL (NeonDB) - Main application database
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL_TEST=postgresql://username:password@host:port/test_database?sslmode=require

# Google Sheets API
GOOGLE_SHEETS_SPREADSHEET_ID=your_default_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Email Service (Choose ONE: Resend OR SMTP)
# Option 1: Resend (API-based)
RESEND_API_KEY=re_your_resend_api_key_here

# Option 2: SMTP (Outlook, Gmail, etc.)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your.email@mahidol.ac.th
# SMTP_PASS=your_app_password

EMAIL_FROM=your.email@mahidol.ac.th
EMAIL_FROM_NAME=MUICT Web Rendering Platform
